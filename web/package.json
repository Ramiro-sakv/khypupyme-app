{
  "name": "khypupyme-web",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../server/KhypuPyme.Api/obj/openapi/khypupyme.json -o src/api/schema.d.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "pdfmake": "0.2.20",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/pdfmake": "0.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
