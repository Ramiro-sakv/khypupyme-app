{
  "name": "khypupyme-app",
  "version": "0.5.0-beta.3",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:rules": "vitest run --project rules",
    "test:e2e": "playwright test",
    "test:emulators": "pnpm build:functions && node scripts/test-emulators.mjs",
    "emulators": "pnpm build:functions && node scripts/emulators.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:functions",
    "build:functions": "pnpm --filter @khypupyme/functions build",
    "build:android:web": "node scripts/build-native-web.mjs android",
    "build:windows:web": "node scripts/build-native-web.mjs windows",
    "android:sync": "pnpm build:android:web && cap sync android",
    "android:build": "pnpm android:sync && cd android && gradlew.bat assembleDebug",
    "windows:build": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "firebase": "13.1.0",
    "pdfmake": "0.2.20",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.0",
    "@types/pdfmake": "0.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.34.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
